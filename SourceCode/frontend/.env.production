# Production builds (Amplify): show the SOP detector's "Steps read from the video" panel.
# On AWS the detector runs beside the backend in its container, at /sop-detector on the
# backend's host (src/services/api/sopDetector.ts). A variable set in the build's own
# environment wins over this file, so docker compose, which passes "false", keeps it off.
VITE_SOP_DETECTOR_ENABLED=true
