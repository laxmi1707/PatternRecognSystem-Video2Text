APP_NAME="video2Text API"
APP_VERSION="0.1.0"
DEBUG=true

DATABASE_URL="sqlite+aiosqlite:///./video2text.db"

# CORS - the local Vite dev server
ALLOWED_ORIGINS=["http://localhost:5173"]

# Optional: point Search at a local folder of app/<task_id>/video2knowledge_labels.jsonl
# documents to build a demo search index from. Leave unset to have Search return no results.
# SEARCH_CORPUS_DIR="C:\path\to\Video CUA collect"
