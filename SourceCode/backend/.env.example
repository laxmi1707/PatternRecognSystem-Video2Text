APP_NAME="video2Text API"
APP_VERSION="0.1.0"
DEBUG=false

DATABASE_URL="sqlite+aiosqlite:///./video2text.db"

# CORS - the local Vite dev server
ALLOWED_ORIGINS=["http://localhost:5173"]

# API key authentication (empty = auth disabled for local dev)
API_KEY=

# Model artifacts: pulled from S3 at startup, falling back to ./models on any failure.
# These are the defaults; set MODEL_S3_BUCKET= (empty) to use only the local ./models directory.
MODEL_S3_BUCKET=video2knowledge-dev-model-artifacts-984263476980
MODEL_S3_PREFIX=models/v3
MODEL_S3_REGION=ap-southeast-1
MODEL_S3_REQUIRE_CHECKSUM=false
