# Everything here is regenerable from the code plus the public dataset, and is
# far too large to version. The numbers that the report cites are the CSVs and
# JSON under runs/, which ARE committed.

# The dataset itself (26 GB on Hugging Face at ServiceNow/VideoCUA)
data/
# Per-recording feature vectors: ~480 MB, rebuilt by `python -m v2k frames`
cache/*
# YOLOv8n and ResNet-18 weights, downloaded on first use
weights/
# Fitted models of the three full-dataset classification runs (814 MB together) are
# attached to the GitHub release models-2026-10-17 instead of being versioned here.
# Every other run's fitted models are committed (about 300 MB).
runs/run_010_v2-full-tasklevel/models/
runs/run_012_v2-full-segment/models/
runs/run_013_v3-tasklevel/models/
# Frozen fold matrices and stored predictions used by the tuning shards
*.npz

.venv/
__pycache__/
*.pyc
logs/

# Personal notes and unsent drafts stay out of the shared repo
~$*

# SOP detector deployment: the assembled build context and Terraform state
deploy/sop-detector/build/
deploy/sop-detector/terraform/.terraform/
deploy/sop-detector/terraform/*.tfstate*
deploy/sop-detector/terraform/*.tfvars
